# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Razorpay API Credentials (Indian Payment Gateway)
# Obtain from https://dashboard.razorpay.com/app/keys (Test or Live)
# If empty or not set, the app runs in realistic Test Simulator mode.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Admin Panel Authentication Password (default: admin123)
ADMIN_PASSWORD="admin"

# SMTP Mail Server Configuration (Automated PDF Delivery via nodemailer)
# Configure your SMTP credentials to send instant e-book PDFs directly to customer inboxes
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""

# Email Notification Webhook / Service (Optional)
EMAIL_SERVICE_API_KEY=""

